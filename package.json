    "preview": "wrangler dev",
    "test": "node qa/guards.js && node qa/smoke.js"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.0",
    "wrangler": "^4.114.0"
  }
}
