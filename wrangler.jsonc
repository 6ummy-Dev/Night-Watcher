{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-watcher",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  /* The apex, bound as a custom domain rather than a route: Cloudflare then
     owns the DNS record and the certificate, and there is one place to look
     when either is wrong. GitHub Pages keeps serving the same tree at its own
     address on purpose \u2014 see the move offer in docs/index.html. */
  "routes": [
    { "pattern": "nightwatcher.life", "custom_domain": true }
  ],
  /* The workers.dev preview hostname served the whole app and was indexable,
     so the site competed with itself in search. There is nothing to
     consolidate if there is nothing there. The apex is the preview now. */
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs",
    /* "404-page" as of 2.1.0, still NOT "single-page-application". The app
       is one page with hash routing, so SPA fallback buys nothing — and it
       would turn every missing asset into a cached-as-HTML 200, which is why
       it stays banned. "404-page" serves docs/404.html WITH a 404 status:
       still a real 404 to sw.js (never cached) and to crawlers (noindex),
       just one that speaks the house's language. qa/guards.js enforces both
       halves. */
    "not_found_handling": "404-page"
  }
}
