{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-watcher",
  "compatibility_date": "2026-07-27",
  /* The apex, bound as a custom domain rather than a route: Cloudflare then
     owns the DNS record and the certificate, and there is one place to look
     when either is wrong. One hostname is one binding — never also a route.

     THERE IS ONE ORIGIN: nightwatcher.life, served by this Worker. GitHub Pages
     is unpublished and stays unpublished. (A stale version of this comment
     once argued for the mirror after the project had retired it, and the
     mirror came back — the story is in NOTES.md.) */
  "routes": [
    { "pattern": "nightwatcher.life", "custom_domain": true }
  ],
  /* The workers.dev preview hostname served the whole app and was indexable,
     so the site competed with itself in search. There is nothing to
     consolidate if there is nothing there. The apex is the preview now. */
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  /* The `main` script owns two request shapes: `GET /` with an Accept header
     that prefers text/markdown gets llms.txt as the markdown representation,
     and GET /.well-known/api-catalog answers an empty RFC 9727 linkset (the
     honest "no API"). run_worker_first is scoped to exactly those two paths:
     every OTHER path is served by the assets plane directly and cannot be
     intercepted, slowed, or altered by worker code. "/" has an asset behind
     it and falls through byte-for-byte for browsers; "/.well-known/api-catalog"
     has none, so scoping the worker to it costs no asset the hop. Guard 133
     executes every branch. */
  "main": "worker.js",
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/.well-known/api-catalog"],
    /* "404-page", NOT "single-page-application". The app is one page with
       hash routing, so SPA fallback buys nothing — and it would turn every
       missing asset into a cached-as-HTML 200, which is why it stays banned.
       "404-page" serves docs/404.html WITH a 404 status: still a real 404 to
       sw.js (never cached) and to crawlers (noindex), just one that speaks
       the house's language. qa/guards.js enforces both halves. */
    "not_found_handling": "404-page"
  }
}
