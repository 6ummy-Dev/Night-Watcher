{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-watcher",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  /* The apex, bound as a custom domain rather than a route: Cloudflare then
     owns the DNS record and the certificate, and there is one place to look
     when either is wrong. GitHub Pages keeps serving the same tree at its own
     address on purpose \u2014 see the move offer in docs/index.html. */
  "routes": [
    { "pattern": "nightwatcher.life", "custom_domain": true }
  ],
  /* The workers.dev preview hostname served the whole app and was indexable,
     so the site competed with itself in search. There is nothing to
     consolidate if there is nothing there. The apex is the preview now. */
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs",
    /* "none" on purpose, NOT "single-page-application". The app is one page
       with hash routing (#life, #progress...), and hashes never reach the
       server, so SPA fallback buys nothing here. What it DOES do is turn
       every missing-asset request into a 200 text/html response — and sw.js
       caches any ok response, so a missing icon would get cached as HTML
       under the icon's URL and stay wrong until the next deploy. A 404
       should be a 404. qa/guards.js enforces this. */
    "not_found_handling": "none"
  }
}
